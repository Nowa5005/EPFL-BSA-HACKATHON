# Copy to .env (never commit .env). All values are optional — sensible defaults are built in.

# Comma-separated public Sepolia RPCs (no API key needed)
SEPOLIA_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org

# WebAuthn relying party (must match the URL you open in the browser)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Allows scripts/e2e-demo.ts to run without a browser passkey (headless demo client only).
ALLOW_HEADLESS_CLIENTS=true

# Service authentication (generated automatically into .env in development; REQUIRED in production).
# HMAC key of the session tokens issued by sq-bank and verified by every service.
SESSION_SIGNING_KEY=
# Service-to-service token (header x-internal-token) used by the services and the dev scripts.
INTERNAL_API_TOKEN=
# Browser/app origins allowed to call the services (comma separated, exact match; required in production).
# Default in development: http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,https://localhost
ALLOWED_ORIGINS=

# Market data (services/market-data). No key needed; an optional CoinGecko demo key raises the rate limits (server-side only).
COINGECKO_API_KEY=
# Where the other services reach market-data (default http://localhost:4004)
MARKET_URL=
# Alert evaluation interval in ms (default 60000, minimum 5000)
ALERT_EVAL_MS=
# Travel Rule: allow third-party transfers without a transmission integration, clearly labelled as demo (default: on outside production)
TRAVEL_RULE_DEMO_MODE=
