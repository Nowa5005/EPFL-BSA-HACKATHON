{
  "name": "sq-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "SQ Wallet — self-custody Safe 2-of-3 wallet prototype (Swissquote Wallet Challenge, EPFL hackathon)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/fund-check.ts --quiet; concurrently -k -n cosigner,partner,bank,market,web -c blue,magenta,green,yellow,cyan \"npm:dev:cosigner\" \"npm:dev:partner\" \"npm:dev:bank\" \"npm:dev:market\" \"npm:dev:web\"",
    "dev:services": "concurrently -k -n cosigner,partner,bank,market -c blue,magenta,green,yellow \"npm:dev:cosigner\" \"npm:dev:partner\" \"npm:dev:bank\" \"npm:dev:market\"",
    "dev:cosigner": "npm run dev -w services/sq-cosigner",
    "dev:partner": "npm run dev -w services/recovery-partner",
    "dev:bank": "npm run dev -w services/sq-bank",
    "dev:market": "npm run dev -w services/market-data",
    "dev:web": "npm run dev -w apps/web",
    "app:build": "npm run app:build -w @sq/mobile",
    "app:sync": "npm run app:sync -w @sq/mobile",
    "app:ios": "npm run app:ios -w @sq/mobile",
    "app:android": "npm run app:android -w @sq/mobile",
    "app:preview": "npm run app:preview -w @sq/mobile",
    "app:doctor": "npm run app:doctor -w @sq/mobile",
    "e2e": "tsx scripts/e2e-demo.ts",
    "escape-hatch": "tsx scripts/escape-hatch.ts",
    "fund-check": "tsx scripts/fund-check.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "test": "node --import tsx --test services/sq-cosigner/test/*.test.ts services/market-data/test/*.test.ts services/sq-bank/test/*.test.ts packages/shared/test/*.test.ts apps/web/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nowa5005/EPFL-BSA-HACKATHON.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.0",
    "playwright": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@safe-global/safe-deployments": "^1.37.0",
    "dotenv": "^17.0.0",
    "ethers": "^6.15.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "shamir-secret-sharing": "^0.0.4"
  }
}
