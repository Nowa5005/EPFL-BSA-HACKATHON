{
  "name": "sq-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "SQ Wallet — self-custody Safe 2-of-3 wallet prototype (Swissquote Wallet Challenge, EPFL hackathon)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/fund-check.ts --quiet; concurrently -k -n cosigner,partner,bank,market,vasp,web -c blue,magenta,green,yellow,gray,cyan \"npm:dev:cosigner\" \"npm:dev:partner\" \"npm:dev:bank\" \"npm:dev:market\" \"npm:dev:vasp\" \"npm:dev:web\"",
    "dev:services": "concurrently -k -n cosigner,partner,bank,market,vasp -c blue,magenta,green,yellow,gray \"npm:dev:cosigner\" \"npm:dev:partner\" \"npm:dev:bank\" \"npm:dev:market\" \"npm:dev:vasp\"",
    "dev:cosigner": "npm run dev -w services/sq-cosigner",
    "dev:partner": "npm run dev -w services/recovery-partner",
    "dev:bank": "npm run dev -w services/sq-bank",
    "dev:market": "npm run dev -w services/market-data",
    "dev:vasp": "npm run dev -w services/vasp-mock",
    "dev:web": "npm run dev -w apps/web",
    "app:build": "npm run app:build -w @sq/mobile",
    "app:sync": "npm run app:sync -w @sq/mobile",
    "app:ios": "npm run app:ios -w @sq/mobile",
    "app:android": "npm run app:android -w @sq/mobile",
    "app:preview": "npm run app:preview -w @sq/mobile",
    "app:doctor": "npm run app:doctor -w @sq/mobile",
    "e2e": "tsx scripts/e2e-demo.ts && tsx scripts/e2e-protection.ts",
    "escape-hatch": "tsx scripts/escape-hatch.ts",
    "fund-check": "tsx scripts/fund-check.ts",
    "check-bind": "tsx scripts/check-bind.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "test": "node --import tsx --test services/sq-cosigner/test/*.test.ts services/market-data/test/*.test.ts services/sq-bank/test/*.test.ts services/vasp-mock/test/*.test.ts packages/shared/test/*.test.ts apps/web/test/*.test.ts contracts/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "screenshots": "tsx scripts/screenshots.ts",
    "build:contracts": "tsx scripts/build-contracts.ts",
    "test:contracts": "tsx scripts/build-contracts.ts --check && node --import tsx --test contracts/test/*.test.ts",
    "deploy:guard": "tsx scripts/deploy-guard.ts",
    "redeploy": "tsx scripts/redeploy-safe.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nowa5005/EPFL-BSA-HACKATHON.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.0",
    "hardhat": "^2.29.1",
    "playwright": "^1.64.0",
    "solc": "0.8.30",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@safe-global/safe-deployments": "^1.37.0",
    "bitcoinjs-lib": "7.0.2",
    "dotenv": "^17.0.0",
    "ecpair": "3.0.2",
    "ethers": "^6.15.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "shamir-secret-sharing": "^0.0.4",
    "tiny-secp256k1": "2.2.4"
  }
}
